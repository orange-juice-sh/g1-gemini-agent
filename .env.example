# .env にコピーして使う（.env はコミットしない）
GEMINI_API_KEY=...
# G1_MODEL=gemini                 # 既定の頭脳（gemini / local / mock / claude-...）
# GEMINI_THINKING_LEVEL=low
# GEMINI_TIMEOUT=120

# Claude API を使う場合
ANTHROPIC_API_KEY=sk-ant-...
